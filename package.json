{
  "name": "skill-eval",
  "version": "0.1.0",
  "description": "A CLI that evaluates LLM skills with test cases",
  "type": "module",
  "bin": {
    "skill-eval": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "typescript": "6.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
